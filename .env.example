# Copy to .env and fill in. For local development, run `supabase start` and
# use the API_URL / ANON_KEY it prints (see README / CLAUDE.md).
#
# Android emulator note: 127.0.0.1 refers to the emulator itself, not the
# host machine — use http://10.0.2.2:54321 instead when running on Android.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
